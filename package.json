{
  "name": "react-virtual-checkbox-tree-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for react-virtual-checkbox-tree and its documentation site.",
  "author": "Jade Ghadry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadghadry/react-virtual-checkbox-tree.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace react-virtual-checkbox-tree",
    "build:web": "npm run build --workspace web",
    "dev": "npm run dev --workspace web",
    "dev:lib": "npm run dev --workspace react-virtual-checkbox-tree",
    "test": "npm run test --workspace react-virtual-checkbox-tree",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "npm run bench --workspace react-virtual-checkbox-tree",
    "lint:package": "npm run lint:package --workspace react-virtual-checkbox-tree",
    "sync:readme": "node scripts/sync-readme.mjs",
    "release": "npm publish --workspace react-virtual-checkbox-tree",
    "check:drift": "node scripts/check-docs-drift.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
